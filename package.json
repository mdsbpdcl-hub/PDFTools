{
  "name": "pdf-desk",
  "version": "1.0.0",
  "description": "Browser-based PDF tools. Files stay on your device.",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "npm run copy-assets",
    "dev": "vite",
    "prebuild": "npm run copy-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@pdf-lib/fontkit": "1.1.1",
    "diff": "9.0.0",
    "docx": "9.15.3",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
